# ─── API Provider Selection ───────────────────────────────────────────────────
# Choose your metadata provider: "musicbrainz" (free, no key) or "spotify"
API_PROVIDER=musicbrainz

# ─── MusicBrainz (no credentials required) ────────────────────────────────────
# Identifies your app to the MusicBrainz API (required by their ToS).
# Format: AppName/Version (contact-email)
MUSICBRAINZ_USER_AGENT=SongTag/1.0.0 (your@email.com)

# ─── Spotify (optional — only needed if API_PROVIDER=spotify) ─────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Must EXACTLY match a Redirect URI added in your Spotify app settings.
# Required for the Spotify→MP3 tab (reading your private playlists).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/callback

# ─── File System ──────────────────────────────────────────────────────────────
# Absolute or relative path to the folder containing your MP3 files.
# Defaults to ./music if not set.
MP3_FOLDER=./music

# ─── Behaviour ────────────────────────────────────────────────────────────────
# Maximum number of concurrent API requests (default: 3)
CONCURRENCY=3

# Delay in milliseconds between API requests to avoid rate-limiting (default: 1000)
REQUEST_DELAY_MS=1000

# ─── Web UI ───────────────────────────────────────────────────────────────────
# Port for the local web UI (default: 4000)
PORT=4000
