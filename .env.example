# ─── API Provider Selection ───────────────────────────────────────────────────
# Choose your metadata provider:
#   "discogs"     — rich release database, needs a free personal access token
#   "spotify"     — great metadata, but subject to Spotify API rate limits
#   "musicbrainz" — free, no key (sparser database)
API_PROVIDER=discogs

# ─── Discogs (only needed if API_PROVIDER=discogs) ────────────────────────────
# Generate a free personal access token at:
#   https://www.discogs.com/settings/developers  (click "Generate new token")
# Authenticated requests get 60/min; the token identifies you to Discogs.
DISCOGS_TOKEN=your_discogs_personal_access_token_here
# Unique User-Agent identifying this app to Discogs (required by their ToS).
DISCOGS_USER_AGENT=SongTag/1.0.0 +https://github.com/dswangers/songTag

# ─── MusicBrainz (no credentials required) ────────────────────────────────────
# Identifies your app to the MusicBrainz API (required by their ToS).
# Format: AppName/Version (contact-email)
MUSICBRAINZ_USER_AGENT=SongTag/1.0.0 (your@email.com)

# ─── Spotify (optional — only needed if API_PROVIDER=spotify) ─────────────────
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id_here
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret_here
# Must EXACTLY match a Redirect URI added in your Spotify app settings.
# Required for the Spotify→MP3 tab (reading your private playlists).
SPOTIFY_REDIRECT_URI=http://127.0.0.1:4000/callback

# ─── File System ──────────────────────────────────────────────────────────────
# Absolute or relative path to the folder containing your MP3 files.
# Defaults to ./music if not set.
MP3_FOLDER=./music

# ─── Behaviour ────────────────────────────────────────────────────────────────
# Maximum number of concurrent API requests (default: 3)
CONCURRENCY=3

# Delay in milliseconds between API requests to avoid rate-limiting (default: 1000)
REQUEST_DELAY_MS=1000

# ─── Web UI ───────────────────────────────────────────────────────────────────
# Port for the local web UI (default: 4000)
PORT=4000
